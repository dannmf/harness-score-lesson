{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pretooluse-bash-gate.js",
            "timeout": 10,
            "statusMessage": "Verificando comando com o gate do repositorio..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/posttooluse-biome-format.js",
            "timeout": 15,
            "statusMessage": "Formatando com Biome..."
          }
        ]
      }
    ]
  }
}
